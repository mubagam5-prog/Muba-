rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.email is string &&
             data.email.size() <= 120 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredLanguage is string &&
             data.preferredLanguage in ['en', 'es', 'fr', 'de', 'ar', 'om', 'am'] &&
             data.darkMode is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCreation(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.type is string &&
             data.type in ['IMAGE', 'VIDEO'] &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.prompt is string &&
             data.prompt.size() >= 1 &&
             data.prompt.size() <= 1000 &&
             (!('motionStyle' in data) || (data.motionStyle is string && data.motionStyle.size() <= 80)) &&
             data.durationSeconds is int &&
             data.durationSeconds in [0, 5, 10] &&
             data.quality is string &&
             data.quality in ['1K', 'HD', '4K'] &&
             data.localFileName is string &&
             data.localFileName.size() >= 1 &&
             data.localFileName.size() <= 200 &&
             (!('thumbnailBase64' in data) || (data.thumbnailBase64 is string && data.thumbnailBase64.size() <= 100000)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'preferredLanguage', 'darkMode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'darkMode', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'darkMode', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /creations/{creationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         incoming().keys().hasAll(['userId', 'type', 'title', 'prompt', 'durationSeconds', 'quality', 'localFileName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'type', 'title', 'prompt', 'motionStyle', 'durationSeconds', 'quality', 'localFileName', 'thumbnailBase64', 'createdAt', 'updatedAt']) &&
                         isValidCreation(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         isValidCreation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().type == existing().type &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
      }
    }
  }
}
